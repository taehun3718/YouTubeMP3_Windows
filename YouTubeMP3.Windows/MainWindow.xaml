<Window x:Class="YouTubeMP3.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="YouTube MP3 - Windows" Width="1190" Height="780"
        MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="430" MinWidth="350" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="470" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,6,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="YouTube 검색" FontWeight="Bold" FontSize="19" Margin="4,0,0,12" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryText" Grid.Column="0" Height="35" VerticalContentAlignment="Center"
                     Margin="0,3,4,3" Padding="8,0" KeyDown="QueryText_KeyDown" />
            <Button x:Name="SearchButton" Grid.Column="1" Content="검색" Click="SearchButton_Click" />
          </Grid>
          <TextBlock x:Name="SearchStatus" Foreground="#6B7280" FontSize="12" Margin="4,0,0,6" />
        </StackPanel>
        <Button x:Name="MoreButton" DockPanel.Dock="Bottom" Content="다음 결과 20개 불러오기"
                Height="39" Visibility="Collapsed" Click="MoreButton_Click" />
        <ListBox x:Name="VideoList" BorderThickness="0" SelectionChanged="VideoList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,6" Height="88">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="136" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="6" ClipToBounds="True" Width="130" Height="76"
                        HorizontalAlignment="Left" Background="#E5E7EB">
                  <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="7,2,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                             MaxHeight="39" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Channel}" Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Duration}" Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18" Margin="6,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="EmptyLabel" Text="왼쪽에서 동영상을 선택하세요"
                     FontSize="19" Foreground="#6B7280" HorizontalAlignment="Center" Margin="20,100" />
          <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
            <Border Height="315" Background="Black" CornerRadius="8" ClipToBounds="True">
              <wv2:WebView2 x:Name="PreviewBrowser" />
            </Border>
            <TextBlock x:Name="VideoTitle" FontWeight="Bold" FontSize="19" Margin="0,14,0,4" />
            <TextBlock x:Name="VideoChannel" Foreground="#6B7280" Margin="0,0,0,18" />
            <CheckBox x:Name="RightsCheck" Content="이 영상의 다운로드 및 MP3 변환 권한이 있습니다"
                      Checked="RightsCheck_Changed" Unchecked="RightsCheck_Changed" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="MP3 음질" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="BitrateCombo" Width="132" SelectedIndex="1">
                <ComboBoxItem Content="128 kbps" Tag="128" />
                <ComboBoxItem Content="192 kbps" Tag="192" />
                <ComboBoxItem Content="256 kbps" Tag="256" />
                <ComboBoxItem Content="320 kbps" Tag="320" />
              </ComboBox>
            </StackPanel>
            <WrapPanel Margin="0,8,0,12">
              <Button Content="YouTube 원본 열기" Click="OpenVideo_Click" />
              <Button x:Name="ConvertButton" Content="공유 URL → MP3 자동 변환"
                      Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                      IsEnabled="False" Click="ConvertButton_Click" />
            </WrapPanel>
            <Border x:Name="ProgressPanel" Background="#F1F5F9" CornerRadius="8"
                    Padding="12" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="PhaseText" Foreground="#475569" Margin="0,0,0,12" />
                <TextBlock x:Name="DownloadLabel" Text="파일 다운로드 0%" />
                <ProgressBar x:Name="DownloadProgress" Height="11" Minimum="0" Maximum="100" Margin="0,7,0,12" />
                <TextBlock x:Name="ConversionLabel" Text="MP3 변환 (PCM → 인코딩) 0%" />
                <ProgressBar x:Name="ConversionProgress" Height="11" Minimum="0" Maximum="100" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ResultStatus" Foreground="#2563EB" Margin="0,13,0,0" />
            <WrapPanel>
              <Button x:Name="OpenFolderButton" Content="탐색기에서 MP3 보기" Click="OpenFolder_Click"
                      Visibility="Collapsed" />
              <Button x:Name="OpenFileButton" Content="MP3 열기" Click="OpenFile_Click"
                      Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock Margin="0,20,0,0" FontSize="12" Foreground="#6B7280"
                       Text="YouTube 검색과 다운로드는 yt-dlp를 사용합니다. 인코딩은 FFmpeg/libmp3lame으로 수행하며 중간 WAV 파일을 생성하지 않습니다. 권한이 있는 콘텐츠만 다운로드하세요." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
